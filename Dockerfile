COPY <<'FAMILY_SOURCE_1_END' /app/api.mjs
import { env } from './database.mjs';
export const dynamic = 'force-dynamic';
const json=(data        ,status=200)=>Response.json(data,{status,headers:{'Cache-Control':'no-store','Referrer-Policy':'no-referrer'}});
const hash=async(s       )=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s)))).map(x=>x.toString(16).padStart(2,'0')).join('');
const token=()=>Array.from(crypto.getRandomValues(new Uint8Array(24))).map(x=>x.toString(16).padStart(2,'0')).join('');
const db=()=>{if(!env.DB)throw new Error('云端数据库尚未就绪');return env.DB;};
                                                                                           
async function access(req        ){
 const code=req.headers.get('x-family-code')||'';
 if(!/^[a-f0-9]{48}$/.test(code))return null;
 const h=await hash(code);
 const f=await db().prepare('SELECT * FROM families WHERE edit_hash = ? OR view_hash = ?').bind(h,h).first           ();
 return f?{...f,canEdit:f.edit_hash===h}:null;
}
export async function GET(req        ){
 try{
 const f=await access(req);if(!f)return json({error:'邀请码无效，请确认后重试。'},401);
 const result=await db().prepare('SELECT * FROM members WHERE family_id = ? ORDER BY generation, name, id').bind(f.id).all();
 return json({family:{id:f.id,name:f.name},canEdit:f.canEdit,members:result.results,serverTime:new Date().toISOString()});
 }catch(e){console.error(e);return json({error:'云端暂时不可用，请稍后重试。'},503);}
}
export async function POST(req        ){
 try{
 if(req.headers.get('origin') && req.headers.get('origin')!==new URL(req.url).origin)return json({error:'请求来源无效'},403);
 if(Number(req.headers.get('content-length')||0)>16000)return json({error:'资料过长'},413);
 const raw=await req.text();
 if(raw.length>16000)return json({error:'资料过长'},413);
 let b;try{b=JSON.parse(raw);}catch{return json({error:'无效的提交内容'},400);}
 if(b.action==='create'){
  const name=typeof b.name==='string'?b.name.trim():'';
  if(!name||name.length>40)return json({error:'请填写40字以内的家谱名称'},400);
  const id=crypto.randomUUID(),editCode=token(),viewCode=token();
  await db().prepare('INSERT INTO families (id,name,edit_hash,view_hash,created_at) VALUES (?,?,?,?,?)').bind(id,name,await hash(editCode),await hash(viewCode),new Date().toISOString()).run();
  return json({editCode,viewCode});
 }
 const f=await access(req);if(!f)return json({error:'邀请码无效'},401);
 if(!f.canEdit)return json({error:'这是查看码，请使用编辑码修改家谱。'},403);
 const m=b.member;
 if(b.action!=='save'||!m||typeof m.name!=='string'||!m.name.trim()||m.name.length>40||!Number.isInteger(m.generation)||m.generation<1||m.generation>5)return json({error:'姓名必填，世代须为一至五代。'},400);
 for(const [k,max] of [['birth',20],['death',20],['origin',100],['story',2000],['editor',40]]         )if(typeof m[k]!=='string'||m[k].length>max)return json({error:'资料格式错误或内容过长'},400);
 if(!['男','女','未注明'].includes(m.gender))return json({error:'请选择性别'},400);
 const existing=m.id?await db().prepare('SELECT * FROM members WHERE id = ? AND family_id = ?').bind(m.id,f.id).first():null;
 if(m.id&&!existing)return json({error:'此成员不存在，请刷新。'},404);
 if(existing&&existing.generation!==m.generation)return json({error:'已有成员的世代不能直接修改，请核对关系。'},400);
 if(m.parentId&&m.parentId===m.secondParentId)return json({error:'两位父母不能是同一人。'},400);
 for(const [key,gen] of [['parentId',m.generation-1],['secondParentId',m.generation-1],['spouseId',m.generation]]         ){
  if(!m[key])continue;
  if(m[key]===m.id)return json({error:'不能把自己设为亲属。'},400);
  const rel=await db().prepare('SELECT id FROM members WHERE id = ? AND family_id = ? AND generation = ?').bind(m[key],f.id,gen).first();
  if(!rel)return json({error:'父母须为上一代成员，配偶须为同代成员。'},400);
 }
 const values=[m.name.trim(),m.generation,m.gender,m.birth,m.death,m.origin,m.story,m.parentId||null,m.secondParentId||null,m.spouseId||null,new Date().toISOString(),m.editor.trim()||'亲友'];
 if(existing){
  const r=await db().prepare('UPDATE members SET name=?,generation=?,gender=?,birth=?,death=?,origin=?,story=?,parent_id=?,second_parent_id=?,spouse_id=?,updated_at=?,editor=?,version=version+1 WHERE id=? AND family_id=? AND version=?').bind(...values,m.id,f.id,m.version).run();
  if(r.meta.changes===0)return json({error:'另一位亲友已更新此人。请关闭表单，重新打开后再修改，避免覆盖。'},409);
 }else{
  const count=await db().prepare('SELECT count(*) AS n FROM members WHERE family_id=?').bind(f.id).first();
  if(Number(count?.n)>=3000)return json({error:'单份家谱最多支持3000位成员。'},400);
  await db().prepare('INSERT INTO members (name,generation,gender,birth,death,origin,story,parent_id,second_parent_id,spouse_id,updated_at,editor,id,family_id,version) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,1)').bind(...values,crypto.randomUUID(),f.id).run();
 }
 return json({ok:true});
 }catch(e){console.error(e);return json({error:'保存失败，请检查网络并重试。'},503);}
}
FAMILY_SOURCE_1_END

COPY <<'FAMILY_SOURCE_2_END' /app/database.mjs
import {mkdirSync,readFileSync} from 'node:fs';
import {fileURLToPath} from 'node:url';
import path from 'node:path';
let DB,healthy,closeDatabase;
if(process.env.DATABASE_URL){
 const {Pool}=await import('pg');
 const pool=new Pool({connectionString:process.env.DATABASE_URL,max:5,connectionTimeoutMillis:10000,idleTimeoutMillis:30000});
 const client=await pool.connect();
 try{
  await client.query('BEGIN');
  await client.query('CREATE TABLE IF NOT EXISTS schema_versions(version TEXT PRIMARY KEY NOT NULL)');
  const version=await client.query('SELECT version FROM schema_versions WHERE version=$1',['0000']);
  if(!version.rows.length){await client.query(readFileSync(new URL('./migrations/0000-postgres.sql',import.meta.url),'utf8'));await client.query('INSERT INTO schema_versions(version) VALUES($1)',['0000']);}
  await client.query('COMMIT');
 }catch(e){await client.query('ROLLBACK');throw e;}finally{client.release();}
 const sqlParams=sql=>{let n=0;return sql.replace(/\?/g,()=>'$'+(++n));};
 DB={prepare(sql){return {bind(...args){const run=()=>pool.query(sqlParams(sql),args);return {
  async first(){return (await run()).rows[0]||null;},async all(){return {results:(await run()).rows};},async run(){return {meta:{changes:(await run()).rowCount||0}};}
 };}};}};
 healthy=async()=>!!(await pool.query('SELECT 1 AS ok')).rows[0]?.ok;
 closeDatabase=()=>pool.end();
}else{
 if(process.env.REQUIRE_CLOUD_DB==='1')throw new Error('DATABASE_URL is required; refusing ephemeral local storage.');
 const {DatabaseSync}=await import('node:sqlite');
 const dir=path.resolve(process.env.DATA_DIR||fileURLToPath(new URL('./data',import.meta.url)));
 mkdirSync(dir,{recursive:true});const sqlite=new DatabaseSync(path.join(dir,'family.sqlite'));
 sqlite.exec('PRAGMA foreign_keys=ON; PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000;');
 sqlite.exec('CREATE TABLE IF NOT EXISTS schema_versions(version TEXT PRIMARY KEY NOT NULL)');
 if(!sqlite.prepare('SELECT version FROM schema_versions WHERE version=?').get('0000')){
  sqlite.exec('BEGIN IMMEDIATE');try{sqlite.exec(readFileSync(new URL('./migrations/0000.sql',import.meta.url),'utf8'));sqlite.prepare('INSERT INTO schema_versions(version) VALUES(?)').run('0000');sqlite.exec('COMMIT');}catch(e){sqlite.exec('ROLLBACK');throw e;}
 }
 DB={prepare(sql){return {bind(...args){const statement=sqlite.prepare(sql);return {
  async first(){return statement.get(...args)||null;},async all(){return {results:statement.all(...args)};},async run(){const r=statement.run(...args);return {meta:{changes:Number(r.changes)}};}
 };}};}};
 healthy=async()=>!!sqlite.prepare('SELECT 1 AS ok').get()?.ok;closeDatabase=async()=>sqlite.close();
}
export const env={DB};
export {healthy,closeDatabase};
FAMILY_SOURCE_2_END

COPY <<'FAMILY_SOURCE_3_END' /app/server.mjs
import { createServer } from 'node:http';
import { readFileSync } from 'node:fs';
import { GET,POST } from './api.mjs';
import { healthy,closeDatabase } from './database.mjs';
const staticFiles=new Map([
 ['/', ['index.html','text/html; charset=utf-8']],
 ['/index.html',['index.html','text/html; charset=utf-8']],
 ['/app.js',['app.js','text/javascript; charset=utf-8']],
 ['/styles.css',['styles.css','text/css; charset=utf-8']],
 ['/favicon.svg',['favicon.svg','image/svg+xml']],
].map(([route,[file,type]])=>[route,{body:readFileSync(new URL('./public/'+file,import.meta.url)),type}]));
const server=createServer(async(req,res)=>{
 res.setHeader('X-Content-Type-Options','nosniff');res.setHeader('Referrer-Policy','no-referrer');res.setHeader('X-Frame-Options','DENY');
 const reply=(status,body)=>{res.writeHead(status,{'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'});res.end(JSON.stringify(body));};
 try{
  const protocol=req.headers['x-forwarded-proto']==='https'?'https':'http';
  const origin=process.env.PUBLIC_ORIGIN||process.env.RENDER_EXTERNAL_URL||`${protocol}://${req.headers.host}`;
  const url=new URL(req.url,origin);
  if(url.pathname==='/healthz'){const ok=await healthy();reply(ok?200:503,{ok});return;}
  if(url.pathname==='/api/family'){
   if(!['GET','POST'].includes(req.method)){reply(405,{error:'不支持的请求方法'});return;}
   let size=0;const chunks=[];
   for await(const chunk of req){size+=chunk.length;if(size>16384){reply(413,{error:'资料过长'});return;}chunks.push(chunk);}
   const headers=new Headers();for(const [k,v] of Object.entries(req.headers))if(v!==undefined)headers.set(k,Array.isArray(v)?v.join(', '):v);
   const r=new Request(url,{method:req.method,headers,...(req.method==='POST'?{body:Buffer.concat(chunks)}:{})});
   const result=await(req.method==='GET'?GET(r):POST(r));
   res.writeHead(result.status,Object.fromEntries(result.headers));res.end(Buffer.from(await result.arrayBuffer()));return;
  }
  if(!['GET','HEAD'].includes(req.method)){reply(405,{error:'不支持的请求方法'});return;}
  const file=staticFiles.get(url.pathname);if(!file){reply(404,{error:'页面不存在'});return;}
  res.writeHead(200,{'Content-Type':file.type,'Cache-Control':'no-cache','Content-Security-Policy':"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'"});res.end(req.method==='HEAD'?undefined:file.body);
 }catch(e){console.error('Request failed:',e.message);if(!res.headersSent)reply(500,{error:'服务暂时不可用，请稍后重试。'});else res.end();}
});
const port=Number(process.env.PORT||3000);server.listen(port,process.env.HOST||'0.0.0.0',()=>console.log(`Family tree listening on port ${server.address().port}`));
for(const signal of ['SIGTERM','SIGINT'])process.on(signal,()=>server.close(async()=>{await closeDatabase();process.exit(0);}));
FAMILY_SOURCE_3_END

