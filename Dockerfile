COPY <<'FAMILY_SOURCE_5_END' /app/migrations/0000-postgres.sql
CREATE TABLE "families" (
	"id" text PRIMARY KEY NOT NULL,
	"name" text NOT NULL,
	"edit_hash" text NOT NULL,
	"view_hash" text NOT NULL,
	"created_at" text NOT NULL
);

CREATE INDEX "family_edit_hash" ON "families" ("edit_hash");
CREATE INDEX "family_view_hash" ON "families" ("view_hash");
CREATE TABLE "members" (
	"id" text PRIMARY KEY NOT NULL,
	"family_id" text NOT NULL,
	"name" text NOT NULL,
	"generation" integer NOT NULL,
	"gender" text NOT NULL,
	"birth" text NOT NULL,
	"death" text NOT NULL,
	"origin" text NOT NULL,
	"story" text NOT NULL,
	"parent_id" text,
	"second_parent_id" text,
	"spouse_id" text,
	"version" integer DEFAULT 1 NOT NULL,
	"updated_at" text NOT NULL,
	"editor" text NOT NULL,
	FOREIGN KEY ("family_id") REFERENCES "families"("id") ON UPDATE no action ON DELETE no action
);

CREATE INDEX "members_family" ON "members" ("family_id");
FAMILY_SOURCE_5_END

